pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/katerynaolefir/qa_automation_python.git'
            }
        }

        stage('Clean up and install Python') {
            steps {
                sh '''
                    rm -rf allure-results allure-report

                    apt-get update
                    apt-get install -y python3 python3-dev python3.13-venv

                    python3 -m venv venv
                '''
            }
        }

        stage('Install requirements') {
            steps {
                sh '''
                    venv/bin/python -m pip install --upgrade pip
                    venv/bin/python -m pip install -r requirements.txt
                    venv/bin/python -m pip install allure-pytest

                    venv/bin/python -m playwright install --with-deps chromium
                '''
            }
        }

        stage('Run tests') {
            steps {
                sh '''
                    venv/bin/python -m pytest \
                        tests/ui/sause_demo \
                        -m ui \
                        --alluredir=allure-results
                '''
            }
        }

    }
     post{
            always{
                allure commandline: 'Allure', includeProperties: false, jdk: '', resultPolicy: 'LEAVE_AS_IS', results: [[path: 'allure-results']]
            }
        }
}